{
  "name": "First Steps",
  "short_name": "First Steps",
  "description": "Behind the Scenes of the Internet — favicons, page building blocks and a glossary of web basics.",
  "id": "/",
  "start_url": "/",
  "scope": "/",
  "lang": "en",
  "display": "standalone",
  "theme_color": "#131313",
  "background_color": "#131313",
  "icons": [
    {
      "src": "/icons/android-chrome-192x192.png",
      "sizes": "192x192",
      "type": "image/png"
    },
    {
      "src": "/icons/android-chrome-512x512.png",
      "sizes": "512x512",
      "type": "image/png"
    }
  ],
  "share_target": {
    "action": "/share-target/",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "files": [
        {
          "name": "file",
          "accept": ["image/png", "image/jpeg", "image/webp", "image/gif", "image/svg+xml", "image/*", ".svg"]
        }
      ]
    }
  }
}
